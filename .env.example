# Database
DATABASE_URL=

# Default LLM provider: groq or openrouter
LLM_PROVIDER=groq

# Groq
GROQ_API_KEY=

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Generate a Fernet key for encrypting user API keys
OPENROUTER_KEY_ENCRYPTION_KEY=

# Embeddings: huggingface (default), openai, or openrouter
EMBEDDING_PROVIDER=huggingface
HUGGINGFACE_API_KEY=
